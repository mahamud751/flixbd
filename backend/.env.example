# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database (docker compose exposes postgres on host port 15432) ----
DATABASE_URL="postgresql://flixbd:flixbd@localhost:15432/flixbd?schema=public"

# ---- CORS (comma separated origins; default * when empty) ----
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ---- Auth ----
# Secret used to sign customer and admin JWTs. Change it in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Static admin login for the admin panel (no admin rows in the database)
ADMIN_EMAIL="admin@streamnestbd.com"
ADMIN_PASSWORD="Admin@12345"
